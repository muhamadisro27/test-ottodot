# Copy to .env (gitignored) and adjust as needed.
# Example: cp .env.example .env

# Express API server port (apps/api/src/index.ts)
PORT=4000

# PostgreSQL connection string for the API, drizzle, and seed (dev database)
DATABASE_URL=postgres://ottodot:ottodot@localhost:5432/ottodot

# Separate database used by the Vitest suite.
# Created and migrated automatically by apps/api/test/global-setup.ts.
TEST_DATABASE_URL=postgres://ottodot:ottodot@localhost:5432/ottodot_test
