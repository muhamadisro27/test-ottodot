# Environment variables for the Vercel project (root directory: apps/api).
# Set these in the Vercel dashboard (Project Settings → Environment Variables)
# or with:  vercel env add DATABASE_URL production
#
# Note: PORT and TEST_DATABASE_URL are NOT needed on Vercel:
#   - Vercel injects its own PORT; the serverless entrypoint (api/index.ts)
#     does not use src/index.ts.
#   - TEST_DATABASE_URL is only used by the local Vitest suite.
# dotenv/config never overrides vars already set by the platform, so it is
# safe to keep in the dev entrypoints.

# Neon pooled connection string (serverless-friendly). Example:
# postgres://<user>:<password>@ep-<slug>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgres://<user>:<password>@ep-<slug>-pooler.<region>.aws.neon.tech/ottodot?sslmode=require
