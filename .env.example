# Copy to .env (gitignored) and adjust as needed.
# Example: cp .env.example .env
#
# docker compose reads this file automatically for ${VAR:-default} substitution
# in docker-compose.yml. Keep POSTGRES_* values in sync with DATABASE_URL in
# apps/api/.env.

# PostgreSQL container credentials (docker-compose.yml)
POSTGRES_USER=ottodot
POSTGRES_PASSWORD=ottodot
POSTGRES_DB=ottodot

# Host port PostgreSQL is exposed on (docker-compose.yml)
POSTGRES_PORT=5432

# Reference values used by the API — configured in apps/api/.env
# DATABASE_URL=postgres://ottodot:ottodot@localhost:5432/ottodot
# TEST_DATABASE_URL=postgres://ottodot:ottodot@localhost:5432/ottodot_test

# Base URL of the Express API (Next.js proxy) — configured in apps/web/.env.local
# API_URL=http://localhost:4000
